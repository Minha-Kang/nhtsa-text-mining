      ],
      "patterns": [
        "\\b(?:power steering|steering(?: system| assist)?)\\b[^.;!?\\n]{0,35}\\b(?:(?:fail(?:ed|ure|ing|s)?|malfunction(?:ed|ing|s)?|inoperativ\\w*|not work(?:ing)?|stopped work(?:ing)?)|lock(?:ed|ing|s)?(?: up)?|seized|lost|went out|cut out)\\b",
        "\\b(?:lost|loss of|losing)\\b[^.;!?\\n]{0,25}\\b(?:power steering|steering(?: control| assist)?)\\b",
        "\\b(?:difficult|hard|unable|impossible) to (?:steer|turn (?:the )?(?:steering )?wheel)\\b",
        "\\bsteering\\b[^.;!?\\n]{0,35}\\b(?:became|was|is|felt) (?:very |extremely )?(?:stiff|hard|unresponsive)\\b",
        "\\bsteering wheel\\b[^.;!?\\n]{0,25}\\b(?:fell off|came off|detach\\w*|broke off)\\b"
      ]
    },
    {
      "mode": "transmission_shift_failure",
      "description": "Transmission slips, jerks, fails, or cannot select/hold a gear.",
      "triggers": [
        "transmission",
        "gear",
        "shift",
        "clutch"
      ],
      "patterns": [
        "\\b(?:transmission|gearbox|clutch)\\b[^.;!?\\n]{0,35}\\b(?:(?:fail(?:ed|ure|ing|s)?|malfunction(?:ed|ing|s)?|inoperativ\\w*|not work(?:ing)?|stopped work(?:ing)?)|slip(?:ped|ping|s)?|jerk(?:ed|ing|s)?|stuck|shudder(?:ed|ing|s)?)\\b",
        "\\b(?:unable to|could not|would not|will not|failed to|won't) (?:shift|change gears|engage (?:a |the )?gear)\\b",
        "\\b(?:gear(?:s)?|gear shift)\\b[^.;!?\\n]{0,25}\\b(?:stuck|stick(?:s|ing)?|slip(?:ped|ping|s)?|disengag\\w*|jump\\w* out)\\b",
        "\\b(?:harsh|hard|erratic|rough|delayed) shift(?:ing|s)?\\b"
      ]
    },
    {
      "mode": "fluid_leak",
      "description": "Observed leak of fuel, oil, coolant, brake/transmission or other vehicle fluid.",
      "triggers": [
        "leak",
        "leaking",
        "leakage",
        "spill"
