        "\\bmisfir(?:e|es|ed|ing)\\b",
        "\\b(?:engine|motor|vehicle)\\b[^.;!?\\n]{0,35}\\b(?:ran rough|runs rough|running rough|rough idle|hesitat\\w*)\\b"
