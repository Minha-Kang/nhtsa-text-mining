      "patterns": [
        "\\b(?:tire|tyre|tread|tire belt)\\b[^.;!?\\n]{0,40}\\b(?:blew|blow(?:n|out)?|separat\\w*|ruptur\\w*|burst|deflat\\w*|went flat|lost (?:air|pressure)|losing (?:air|pressure)|split)\\b",
        "\\b(?:tread|belt) separation\\b",
        "\\b(?:tire |tyre )?blowout\\b"
      ]
    },
    {
      "mode": "wheel_detachment",
      "description": "Wheel comes off, separates, or detaches.",
      "triggers": [
        "wheel",
        "rim"
      ],
      "patterns": [
        "(?<!steering )\\b(?:wheel|rim)\\b[^.;!?\\n]{0,40}\\b(?:fell off|came off|coming off|detach\\w*|separat\\w*|broke off)\\b"
      ]
