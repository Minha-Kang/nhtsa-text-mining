        "\\b(?:engine|motor|battery)\\b[^.;!?\\n]{0,30}\\b(?:ran hot|running hot|temperature (?:was |became )?(?:excessive|too high))\\b"
      ]
    },
    {
      "mode": "fire_smoke",
      "description": "Reported actual fire, burning, flames, or visible smoke.",
      "triggers": [
        "fire",
        "flame",
        "smok",
        "burn"
      ],
      "patterns": [
        "\\b(?:caught|catch(?:es|ing)?|on|engulfed in|burst into|erupted in(?:to)?) (?:a )?(?:fire|flames)\\b",
        "\\b(?:fire|flames)\\b[^.;!?\\n]{0,30}\\b(?:erupted|started|occurred|broke out|spread|came|coming|emerged|engulfed)\\b",
        "\\b(?:caus(?:ed|ing)|result(?:ed|ing) in|ignited (?:a )?) (?:a )?fire\\b",
        "\\b(?:smoke|smoking)\\b[^.;!?\\n]{0,40}\\b(?:from|coming|came|emitting|under|inside|filled|pouring)\\b",
        "\\b(?:emitt(?:ed|ing)|saw|observed|noticed|producing|billowing|filled with)\\b[^.;!?\\n]{0,25}\\bsmoke\\b",
        "\\b(?:engine|motor|vehicle|car|truck|suv|van)\\b[^.;!?\\n]{0,35}\\b(?:burned|burnt) (?:up|down|to the ground)\\b"
      ]
    },
    {
      "mode": "airbag_non_deployment",
      "description": "Airbag explicitly fails to deploy/inflate (absence of deployment is positive failure evidence).",
      "triggers": [
