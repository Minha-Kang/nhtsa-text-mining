        "head light",
        "headlamp",
        "tail light",
        "taillight",
        "brake light",
        "turn signal"
      ],
      "patterns": [
        "\\b(?:head\\s?lights?|headlamps?|tail\\s?lights?|brake lights?|turn signals?)\\b[^.;!?\\n]{0,35}\\b(?:(?:fail(?:ed|ure|ing|s)?|malfunction(?:ed|ing|s)?|inoperativ\\w*|not work(?:ing)?|stopped work(?:ing)?)|went out|go out|flicker\\w*|would not (?:turn on|illuminate)|did not (?:turn on|illuminate))\\b",
