{
  "version": "failure-symptom-rules-v2.0.0",
  "kind": "fixed_explainable_multilabel_symptom_rules",
  "label_status": "weak_rule_based_pseudo_labels_not_expert_truth",
  "mode_count": 23,
  "modes": [
    {
      "mode": "engine_stall",
      "description": "Engine/vehicle stalls or stops running unexpectedly.",
      "triggers": [
        "stall",
        "shut",
        "died",
        "cut out",
        "cuts out",
        "stopped running"
      ],
      "patterns": [
        "\\bstall(?:ed|ing|s)?\\b",
        "\\b(?:engine|motor|vehicle|car|truck|suv|van)\\b[^.;!?\\n]{0,35}\\b(?:shut(?:s)? (?:off|down)|died|cut(?:s)? out|stopped running)\\b"
      ]
    },
    {
      "mode": "failure_to_start",
      "description": "Engine/vehicle cannot start or restart.",
      "triggers": [
        "start",
        "crank"
      ],
      "patterns": [
        "\\b(?:engine|motor|vehicle|car|truck|suv|van)\\b[^.;!?\\n]{0,65}\\b(?:would not|will not|won't|did not|does not|doesn't|could not|cannot|can't|failed to|fails to|unable to) (?:re)?start\\b",
        "\\b(?:unable|fail(?:ed|s)?) to (?:re)?start\\b[^.;!?\\n]{0,35}\\b(?:engine|motor|vehicle|car|truck|suv|van)\\b",
        "\\b(?:no[- ]start|crank(?:s|ed|ing)? but (?:will|would|does|did) not start)\\b",
        "\\b(?:engine|motor|vehicle|car|truck|suv|van)\\b[^.;!?\\n]{0,35}\\b(?:would not|will not|won't|did not|does not|could not) crank\\b"
      ]
    },
    {
      "mode": "reduced_engine_power",
      "description": "Explicit loss or reduction of engine/propulsion power or inability to accelerate.",
      "triggers": [
        "power",
        "accelerat"
      ],
      "patterns": [
        "\\b(?:(?:loss|reduction|lack) of|lost|losing|reduced) (?:all |the )?(?:engine|motor|propulsion) power\\b",
        "\\b(?:engine|vehicle|car|truck)\\b[^.;!?\\n]{0,35}\\b(?:lost|loses|losing) (?:all |its )?power\\b(?! (?:steering|brake|assist))",
        "\\b(?:reduced engine power|engine power (?:was )?reduced)\\b",
        "\\b(?:engine|motor|vehicle|car|truck|suv|van)\\b[^.;!?\\n]{0,35}\\b(?:would not|will not|could not|failed to|unable to) accelerat\\w*\\b"
      ]
    },
    {
      "mode": "unintended_acceleration",
      "description": "Acceleration or throttle actuation without the intended driver request.",
      "triggers": [
        "accelerat",
        "throttle",
        "surge",
        "sped up"
      ],
      "patterns": [
        "\\b(?:unintended|uncommanded|unexpected|sudden|uncontrolled) accelerat\\w*\\b",
        "\\baccelerat\\w*\\b[^.;!?\\n]{0,45}\\b(?:on its own|by itself|without (?:pressing|depressing|warning)|unintentionally|unexpectedly|uncontrollably)\\b",
        "\\b(?:accelerator|gas pedal|throttle)\\b[^.;!?\\n]{0,35}\\b(?:stuck|sticking|jammed)\\b",
        "\\b(?:engine|motor|vehicle|car|truck|suv|van)\\b[^.;!?\\n]{0,35}\\b(?:surged|surges|sped up)\\b"
      ]
    },
    {
      "mode": "loss_of_braking",
      "description": "Braking failure, ineffective stopping, or brake pedal losing resistance.",
      "triggers": [
        "brak",
        "pedal",
        "stop"
      ],
      "patterns": [
        "\\b(?:brak(?:e|es|ing)|brak(?:e|ing) system|abs|anti[- ]?lock brakes)\\b[^.;!?\\n]{0,35}\\b(?:fail(?:ed|ure|ing|s)?|malfunction(?:ed|ing|s)?|inoperativ\\w*|not work(?:ing)?|stopped work(?:ing)?)\\b",
        "\\b(?:loss|lost|losing) (?:of )?(?:all )?(?:braking|brake power|brake function|brakes)\\b",
        "\\bbrake pedal\\b[^.;!?\\n]{0,50}\\b(?:went|goes|sank|sinks|fell|dropped|pressed|depressed)\\b[^.;!?\\n]{0,20}\\b(?:floor|all the way down)\\b",
