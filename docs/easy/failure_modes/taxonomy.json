        "axle"
      ],
      "patterns": [
        "\\b(?:suspension|control arm|ball joint|tie rod|strut|coil spring|leaf spring|axle)\\b[^.;!?\\n]{0,35}\\b(?:(?:fail(?:ed|ure|ing|s)?|malfunction(?:ed|ing|s)?|inoperativ\\w*|not work(?:ing)?|stopped work(?:ing)?)|broke|broken|fractur\\w*|separat\\w*|collaps\\w*|snapped)\\b",
        "\\b(?:broken|fractured|snapped) (?:suspension|control arm|ball joint|tie rod|strut|coil spring|leaf spring|axle)\\b"
      ]
    },
    {
