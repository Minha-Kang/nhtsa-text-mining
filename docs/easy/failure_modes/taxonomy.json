        "\\b(?:no|without) (?:any )?brak(?:es|ing)\\b"
      ]
    },
    {
      "mode": "unintended_braking",
      "description": "Brakes engage, lock, or drag without appropriate request.",
      "triggers": [
        "brak",
        "abs"
      ],
      "patterns": [
        "\\b(?:brak(?:e|es|ing)|abs)\\b[^.;!?\\n]{0,35}\\b(?:lock(?:ed|ing|s)? up|locked|seized|dragging|dragged|engaged (?:on their own|by themselves)|activated (?:on its own|by itself))\\b",
        "\\b(?:unintended|unexpected|phantom) braking\\b",
        "\\bbrak(?:e|es|ing)\\b[^.;!?\\n]{0,45}\\b(?:without (?:warning|input|reason)|on (?:its|their) own|by (?:itself|themselves))\\b"
      ]
