      "patterns": [
        "\\b(?:fuel|gasoline|diesel|oil|coolant|antifreeze|brake fluid|transmission fluid|power steering fluid)\\b[^.;!?\\n]{0,40}\\bleak\\w*\\b",
        "\\bleak\\w*\\b[^.;!?\\n]{0,40}\\b(?:fuel|gasoline|diesel|oil|coolant|antifreeze|brake fluid|transmission fluid|power steering fluid)\\b",
        "\\b(?:fuel|gas|oil|coolant|brake|transmission) (?:tank|line|hose|pipe|reservoir|pump|system|seal)\\b[^.;!?\\n]{0,30}\\bleak\\w*\\b"
      ]
    },
    {
      "mode": "overheating",
      "description": "Vehicle, engine, battery or a vehicle part overheats.",
      "triggers": [
        "overheat",
        "temperature",
        "ran hot",
        "running hot"
