        "window",
        "visibility",
        "defrost"
      ],
      "patterns": [
        "\\b(?:wipers?|windshield wipers?|defroster)\\b[^.;!?\\n]{0,35}\\b(?:(?:fail(?:ed|ure|ing|s)?|malfunction(?:ed|ing|s)?|inoperativ\\w*|not work(?:ing)?|stopped work(?:ing)?)|stopp\\w*|stuck|broke|broken)\\b",
        "\\b(?:windshield|window|rear glass)\\b[^.;!?\\n]{0,35}\\b(?:shatter\\w*|crack\\w*|explod\\w*|fogged|fogging)\\b",
