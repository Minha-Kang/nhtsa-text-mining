      "patterns": [
        "\\b(?:door latch|hood latch|tailgate latch|hatch latch)\\b[^.;!?\\n]{0,35}\\b(?:(?:fail(?:ed|ure|ing|s)?|malfunction(?:ed|ing|s)?|inoperativ\\w*|not work(?:ing)?|stopped work(?:ing)?)|broke|broken|stuck)\\b",
